{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    // tsx runs the .ts files directly, so TypeScript only type-checks
    "noEmit": true
  },
  "include": ["src", "prisma", "prisma.config.ts"]
}
